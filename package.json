{
  "name": "team-manager",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter frontend test:e2e",
    "prepare": "prek install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": ">=8.0.2",
      "uuid": ">=10.0.1"
    }
  }
}
