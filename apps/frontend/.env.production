# OpenObserve RUM — production build-time config (Vite bakes VITE_* into the bundle).
# The RUM client token is a public, write-only ingestion credential: it ships in the
# browser JS by design, so it is not a secret (gitleaks-allowlisted in .gitleaks.toml).
# RUM/logs post to same-origin /rum/ and /api/default/rum/, which nginx proxies to
# the in-cluster OpenObserve (see apps/frontend/nginx.conf).
VITE_OO_CLIENT_TOKEN=rumEDrF88GE74XwKP9V
VITE_OO_ORG=default
VITE_OO_SERVICE=team-manager-frontend
VITE_DEPLOYMENT_ENV=production
VITE_OO_INSECURE_HTTP=true
